APP_NAME="Santovate CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=santovate_crm_final
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=santovate_crm_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Santovate public business identity (fill real legal data before merchant verification)
SANTOVATE_SUPPORT_EMAIL=ilyasdwisantoso@gmail.com
SANTOVATE_SUPPORT_PHONE=081293047587
SANTOVATE_WHATSAPP=6281293047587
SANTOVATE_BUSINESS_ADDRESS="Rusun, Jl. Administrasi II No.10, RT.10/RW.9, Petamburan, Kecamatan Tanah Abang, Kota Jakarta Pusat, Daerah Khusus Ibukota Jakarta 1026"

# iPaymu
# Keep both credential sets in production .env. After sandbox testing passes,
# switch only IPAYMU_MODE=production. Sandbox and production VA/API keys differ.
IPAYMU_MODE=sandbox
IPAYMU_ALLOWED_METHODS=va,qris,ewallet,cstore,cc,debitonline,paylater
IPAYMU_SANDBOX_VA=
IPAYMU_SANDBOX_API_KEY=
IPAYMU_PRODUCTION_VA=
IPAYMU_PRODUCTION_API_KEY=
IPAYMU_SANDBOX_URL=https://sandbox.ipaymu.com
IPAYMU_PRODUCTION_URL=https://my.ipaymu.com

# Backward-compatible fallback (optional; prefer the environment-specific keys above)
IPAYMU_VA=
IPAYMU_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Platform Owner (set after platform:owner bootstrap succeeds)
SANTOVATE_PLATFORM_OWNER_EMAIL=

# Commercial approval policy
SANTOVATE_APPROVAL_DISCOUNT_PERCENT=5
SANTOVATE_APPROVAL_HIGH_VALUE=50000000
SANTOVATE_DEFAULT_PAYMENT_TERMS=50% DP, 30% UAT, 20% Go-Live
